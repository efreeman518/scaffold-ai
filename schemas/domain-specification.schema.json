{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-specification.schema.json",
  "title": "Domain Specification",
  "description": "Phase 1 output: pure business domain model. Schema reference: ai/domain-specification-schema.md",
  "type": "object",
  "required": [
    "ProjectName",
    "entities"
  ],
  "properties": {
    "ProjectName": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$",
      "description": "PascalCase project name, no spaces"
    },
    "ProjectDescription": {
      "type": "string"
    },
    "OrganizationName": {
      "type": "string",
      "pattern": "^$|^[A-Z][a-zA-Z0-9]*$",
      "description": "Optional namespace prefix (PascalCase) applied to host/UI projects. Empty string means no prefix - the documented leave-blank convention."
    },
    "projectNamePrefix": {
      "type": "string",
      "enum": [
        "solution-name",
        "none"
      ],
      "default": "solution-name",
      "description": "Controls whether generated project names, folders, and root namespaces are prefixed with the solution name."
    },
    "multiTenant": {
      "type": "boolean",
      "default": true
    },
    "tenantIsolation": {
      "type": "string",
      "enum": [
        "row-level",
        "schema",
        "database"
      ],
      "default": "row-level"
    },
    "globalAdminRole": {
      "type": "string",
      "default": "GlobalAdmin"
    },
    "authProvider": {
      "type": "string",
      "enum": [
        "EntraID",
        "EntraExternal",
        "Google",
        "Facebook",
        "Apple",
        "OAuth2",
        "None"
      ],
      "default": "EntraID"
    },
    "authScenario": {
      "type": "string",
      "enum": [
        "enterprise",
        "external",
        "hybrid"
      ],
      "default": "enterprise"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "valueObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/valueObject"
      },
      "description": "Optional business value objects used by entity properties."
    },
    "domainRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domainRule"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "policyMatrices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policyMatrix"
      }
    },
    "aiCapabilities": {
      "$ref": "#/$defs/aiCapabilities"
    },
    "ontology": {
      "$ref": "#/$defs/ontology"
    }
  },
  "$defs": {
    "ontology": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "description": "Opt-in enterprise ontology projection. Presence of this block makes scripts/generate-ontology.py emit .scaffold/ontology/. See ai/domain-specification-schema.md and support/ontology-projection.md.",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^https?://\\S+[/#]$",
          "description": "IRI base for every concept in this module; must end in / or #."
        },
        "boundedContext": {
          "type": "string",
          "description": "Bounded context label; defaults to ProjectName."
        },
        "owner": {
          "type": "string",
          "description": "Team or role that owns this module of the enterprise model, in business language."
        },
        "alignsWith": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string",
                "pattern": "^https?://\\S+[/#]$"
              }
            }
          },
          "description": "Upstream or enterprise ontologies that alignment.equivalentTo / specializes IRIs may point into."
        }
      }
    },
    "alignment": {
      "type": "object",
      "description": "Pointers from this concept into an upstream ontology listed under ontology.alignsWith.",
      "properties": {
        "equivalentTo": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "description": "External class IRI this concept is equivalent to (owl:equivalentClass)."
        },
        "specializes": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "description": "External class IRI this concept is a subclass of (rdfs:subClassOf)."
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]+$",
          "not": {
            "enum": [
              "Task",
              "Thread",
              "Timer",
              "Type",
              "String",
              "Object",
              "Action",
              "Attribute",
              "File",
              "Path"
            ]
          }
        },
        "description": {
          "type": "string"
        },
        "isTenantEntity": {
          "type": "boolean",
          "default": true
        },
        "aggregateRole": {
          "type": "string",
          "enum": [
            "root",
            "owned-child",
            "join"
          ],
          "description": "Pins aggregate classification when the derived role from relationships is not enough."
        },
        "aggregateParent": {
          "type": "string",
          "description": "When aggregateRole is owned-child or join, the name of the owning aggregate root."
        },
        "extends": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]+$",
          "description": "Ontology only: name of another entity in this file that this entity is a kind of (is-a). Projected as rdfs:subClassOf / baseEntityTypeId."
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ontology only: accepted alternate names. Rejected synonyms recorded in UBIQUITOUS-LANGUAGE.md never appear here."
        },
        "owner": {
          "type": "string",
          "description": "Ontology only: team or role owning this concept when it differs from ontology.owner."
        },
        "systemOfRecord": {
          "type": "boolean",
          "default": true,
          "description": "Ontology only: false marks a concept this application consumes from another system rather than masters."
        },
        "alignment": {
          "$ref": "#/$defs/alignment"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRelationship"
          }
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationRelationship"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityRule"
          }
        },
        "stateMachine": {
          "$ref": "#/$defs/stateMachine"
        },
        "customActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "property": {
      "type": "object",
      "required": [
        "name"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "value_object"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "valueObject"
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "string",
            "enum",
            "flags_enum",
            "number",
            "date",
            "boolean",
            "identifier",
            "money",
            "text",
            "value_object"
          ],
          "default": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Enum/flags_enum values"
        },
        "valueObject": {
          "type": "string",
          "description": "Value object name when kind is value_object"
        },
        "sensitive": {
          "type": "boolean",
          "default": false,
          "description": "Property holds PII, a secret, or regulated data (SSN, national id, tokens, health data). Absence means not sensitive - do not over-apply. Triggers a Security-branch column-level-encryption (Always Encrypted) design decision in Phase 1; see ai/shared-understanding-interview.md and support/data-persistence-advanced.md."
        }
      }
    },
    "valueObject": {
      "type": "object",
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]+$"
        },
        "description": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ontology only: accepted alternate names."
        },
        "alignment": {
          "$ref": "#/$defs/alignment"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/valueObjectField"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityRule"
          }
        },
        "usedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueObjectUse"
          }
        }
      }
    },
    "valueObjectField": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "string",
            "enum",
            "number",
            "date",
            "boolean",
            "identifier",
            "money",
            "text"
          ],
          "default": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Enum values when kind is enum"
        }
      }
    },
    "valueObjectUse": {
      "type": "object",
      "required": [
        "entity",
        "property"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      }
    },
    "childRelationship": {
      "type": "object",
      "required": [
        "name",
        "entity",
        "relationship"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "one-to-many",
            "one-to-one",
            "many-to-many",
            "self-referencing",
            "polymorphic-join"
          ]
        },
        "cascadeDelete": {
          "type": "boolean"
        },
        "selfReferenceKey": {
          "type": "string"
        },
        "polymorphicEntityTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "Ontology only: verb phrase for the relationship read from the declaring entity (has, belongsTo, assignedTo)."
        }
      }
    },
    "navigationRelationship": {
      "type": "object",
      "required": [
        "name",
        "entity"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "Ontology only: verb phrase for the relationship read from the declaring entity (belongsTo, reportsTo)."
        }
      }
    },
    "entityRule": {
      "type": "object",
      "required": [
        "name",
        "condition"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        }
      }
    },
    "domainRule": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errorMessage": {
          "type": "string"
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "required": [
        "field",
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "initial": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "action"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "guard": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "name",
        "raisedBy",
        "trigger"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "raisedBy": {
          "type": "string"
        },
        "trigger": {
          "type": "string",
          "pattern": "^(afterCreate|afterUpdate|afterStatusChange|afterAction\\(.+\\)|afterDelete|scheduled)$"
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "pattern",
        "involvedEntities",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "orchestrator",
            "saga",
            "choreography"
          ]
        },
        "involvedEntities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compensationRequired": {
          "type": "boolean"
        },
        "compensation": {
          "type": "object",
          "properties": {
            "rollbackOrder": {
              "type": "string"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "policyMatrix": {
      "type": "object",
      "required": [
        "name",
        "dimensions",
        "outputs",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "aiCapabilities": {
      "type": "object",
      "properties": {
        "search": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity",
              "searchableFields",
              "intent"
            ],
            "properties": {
              "entity": {
                "type": "string"
              },
              "searchableFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intent": {
                "type": "string"
              }
            }
          }
        },
        "agentWorkflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "involvedEntities"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "involvedEntities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "humanInLoop": {
                "type": "boolean"
              },
              "decisions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
